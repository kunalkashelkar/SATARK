# SAT-SA Root Deployment Environment Configuration
# Copy this file to .env before starting Docker Compose:
# cp .env.example .env

# Application Identification
APP_NAME=SAT-SA
APP_ENV=production
APP_VERSION=OPS-v4.8

# Single Deployed Host Port (Access UI at http://<host>:8000 or http://<host>:80)
HOST_PORT=8000

# Backend Settings (Internal container interface)
API_PORT=8001
LOG_LEVEL=INFO
WORKERS=2

# Database Configuration (Internal PostgreSQL container service)
POSTGRES_DB=sat_sa
POSTGRES_USER=sat_sa
POSTGRES_PASSWORD=sat_sa_enclave_secret
DATABASE_URL=postgresql+psycopg://sat_sa:sat_sa_enclave_secret@postgres:5432/sat_sa

# Security & Enclave Keys
# IMPORTANT: Generate a strong cryptographically random secret in actual production!
SECRET_KEY=sat-sa-enclave-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
ENCLAVE_ID=NCIIPC/ENCLAVE-70B

# Automated Lifecycle on Container Startup
AUTO_MIGRATE=true
AUTO_SEED=true
