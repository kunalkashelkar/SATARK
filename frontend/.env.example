# SAT-SA Frontend Environment Example
# For Production Deployed Single-Origin (Nginx Reverse Proxy):
# Leave VITE_API_BASE_URL empty or set to /api/v1 so requests are routed to the same origin.
VITE_API_BASE_URL=/api/v1

# For Local Development without reverse proxy:
# VITE_API_BASE_URL=http://localhost:8001/api/v1
