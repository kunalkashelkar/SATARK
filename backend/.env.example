APP_NAME="SAT-SA"
APP_ENV="development"
APP_VERSION="OPS-v4.8"
API_HOST="0.0.0.0"
API_PORT=8001
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173"]

# Database Configuration (PostgreSQL by default; sqlite:///./sat_sa.db for offline standalone test)
DATABASE_URL="postgresql+psycopg://sat_sa:sat_sa@localhost:5432/sat_sa"
# Set to true to automatically fallback to sqlite:///./sat_sa.db if PostgreSQL is unreachable during offline local dev
DB_SQLITE_FALLBACK_ON_ERROR=true
SQLITE_DB_URL="sqlite:///./sat_sa.db"

# Security & Enclave settings
SECRET_KEY="sat-sa-enclave-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=480
ENCLAVE_ID="NCIIPC/ENCLAVE-70B"

LOG_LEVEL="INFO"
